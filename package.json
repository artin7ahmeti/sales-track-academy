{
  "name": "salestrack-academy",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "turbo db:generate --filter=@salestrack/database",
    "db:push": "turbo db:push --filter=@salestrack/database",
    "db:migrate": "turbo db:migrate --filter=@salestrack/database",
    "db:seed": "turbo db:seed --filter=@salestrack/database",
    "db:studio": "pnpm --filter @salestrack/database exec prisma studio"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest"
  }
}
